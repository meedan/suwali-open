DEPLOY_ENV=local
KNOWLEDGE_API_PORT=8000
OPENAI_API_KEY=sk-yourkeyhere
OPENAI_MODEL=gpt-4o-mini
MAX_TOKENS=3000
LLM_TIMEOUT_SECONDS=60
LLM_INGESTION_TIMEOUT_SECONDS=180
# router-tier: tight timeout for small routing calls that have a graceful fallback
LLM_ROUTER_TIMEOUT_SECONDS=15
LLM_ROUTER_MAX_RETRIES=1
# Optional default for OpenAI reasoning models (gpt-5*, o*). Per-task LLM_* JSON "reasoning_effort" overrides this.
# MUST NOT be set if using gpt-4o-mini!
# Supported values: 'minimal', 'low', 'medium', and 'high'.
# OPENAI_REASONING_EFFORT=low
# SBERT, OPENAI, or BEDROCK_COHERE (Cohere Embed on AWS Bedrock; same IAM/region as LLM Bedrock).
# EMBEDDING_MODEL_PROVIDER=SBERT
# EMBEDDING_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
EMBEDDING_MODEL_PROVIDER=BEDROCK_COHERE
EMBEDDING_MODEL_NAME=cohere.embed-multilingual-v3
# Optional override when not using defaults (768 SBERT, 1536 OPENAI, 1024 BEDROCK_COHERE), e.g. 384 for *-light Cohere embeds:
# EMBEDDING_VECTOR_DIMENSIONS=1024

# Optional overrides for POST /embed only (CMS message clustering, etc.). Unset fields inherit EMBEDDING_* above.
# For BEDROCK_COHERE, /embed uses document semantics (search_document); primary RAG query path uses search_query.
# EMBED_API_EMBEDDING_MODEL_PROVIDER=SBERT
# EMBED_API_EMBEDDING_MODEL_NAME=sentence-transformers/all-mpnet-base-v2
# EMBED_API_EMBEDDING_VECTOR_DIMENSIONS=768

RETRIEVER_TOP_K=10
RETRIEVER_DOCUMENT_LIMIT=100
RETRIEVER_CHUNK_LIMIT=200
RETRIEVER_RELATIONSHIP_LIMIT=500
RETRIEVER_KG_RELS_ENABLED=0
RETRIEVER_CHUNK_TRUNCATE_CHARS=3000
RETRIEVER_ENABLE_REPHRASING=1
RETRIEVER_ENABLE_HYDE=1
RETRIEVER_RELEVANCE_GATE_ENABLED=0

# recency-first retrieval: search the last N days first, fall back to full corpus if nothing found
RETRIEVER_RECENCY_FIRST_ENABLED=1
RETRIEVER_RECENCY_FIRST_WINDOW_DAYS=30

# dual-retriever temporal settings (used when classifier detects temporal intent)
RETRIEVER_TEMPORAL_WEIGHT=0.7
RETRIEVER_TEMPORAL_DECAY_RATE=0.01
RETRIEVER_TEMPORAL_WEIGHT_PIT=0.8
RETRIEVER_TEMPORAL_DECAY_RATE_PIT=0.05
#RETRIEVER_TEMPORAL_TOP_K_MULTIPLIER=4

# summary synthesis
RETRIEVER_SYNTHESIS_TOP_K=20
RETRIEVER_SYNTHESIS_RECENCY_WEIGHT=0.8  # alpha for temporal synthesis (vs 0.3 normal)
RETRIEVER_TOPICAL_SUMMARY_TOP_K=30  # broader top_k for topical-summary retrieval
SUMMARIZER_MAX_INPUT_CHARS=50000  # max combined chars sent to the summarizer LLM

# document-level canonical entity glossary pass (entity resolution at extraction time)
ENTITY_GLOSSARY_ENABLED=1
ENTITY_GLOSSARY_MAX_ENTITIES=100  # cap on glossary entries injected into the extraction prompt
ENTITY_GLOSSARY_MAX_INPUT_CHARS=150000  # max chars of document text sent to the glossary LLM

# topic extraction (ingestion now, chat later)
TOPIC_EXTRACTION_ENABLED=1
TOPIC_EXTRACTION_MAX_COUNT=5  # max topics returned per ingested document
TOPIC_EXTRACTION_MAX_EXISTING=200  # cap on existing topics injected into the prompt
TOPIC_EXTRACTION_MAX_INPUT_CHARS=8000

MAX_TEXT_INGESTION_SIZE=50000  # max tokens of text allowed for ingestion (per document)

ROUTER_ENABLE_INTERNAL_KB=1
ROUTER_ENABLE_YAGO=0
ROUTER_USE_LLM_CLASSIFIER=1
ROUTER_PARALLEL_EXECUTION=0
ROUTER_ENABLE_DECOMPOSITION=1
ROUTER_DECOMPOSITION_MAX_SUBQUERIES=5
ROUTER_UNIFIED_CLASSIFIER_DECOMPOSER=1  # merge classifier + decomposer into one LLM call

YAGO_QUERY_BACKEND=cypher  # "sparql" or "cypher"
#YAGO_SPARQL_ENDPOINT=https://yago-knowledge.org/sparql/query
YAGO_TIMEOUT_SECONDS=30
YAGO_ENTITY_EXTRACTOR=nltk  # "heuristic", "nltk"
# Neo4j connection for YAGO (when using cypher backend)
YAGO_NEO4J_URI=bolt://neo4j_yago:7687
YAGO_NEO4J_USERNAME=neo4j
YAGO_NEO4J_PASSWORD=0Mt1zB77qI
# Neo4j image preloaded with YAGO; required only with the "yago" compose profile (--with-yago)
#YAGO_NEO4J_IMAGE=
# Neo4j image preloaded with an evaluation dataset; only needed to run evaluation experiments
#NEO4J_EVAL_IMAGE=

#TEXT_SPLITTER=SEMCHUNK
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# SEMCHUNK_TOKENIZER_PROVIDER / SEMCHUNK_TOKENIZER_MODEL_NAME apply to SBERT and OPENAI only; ignored for BEDROCK_COHERE (see above).
# SEMCHUNK_TOKENIZER_PROVIDER=TIKTOKEN
# SEMCHUNK_TOKENIZER_MODEL_NAME=
# TEXT_SPLITTER=FIXED_SIZE
# CHUNK_SIZE=500
# CHUNK_OVERLAP=100
# TEXT_SPLITTER=NLTK
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# MARKDOWN splitter is a bit structure-aware: tries not to break up lists and tables, or headings and content below
# it uses the SEMCHUNK tokenizer settings above for its inner token budget; CHUNK_OVERLAP is ignored.
# .txt files and raw text payloads still use the plain SEMCHUNK splitter (with CHUNK_OVERLAP).
TEXT_SPLITTER=MARKDOWN
MARKDOWN_SPLITTER_BREADCRUMBS=1  # prepend the heading path (e.g. "H1 > H2") to each chunk

# OPENAI or BEDROCK — global default LLM provider (can be overridden per task, see below)
LLM_PROVIDER=OPENAI
# LLM_PROVIDER=BEDROCK
BEDROCK_MODEL=eu.amazon.nova-micro-v1:0
AWS_REGION=eu-west-1
# retry OpenAI calls on BEDROCK_MODEL when they time out or can't connect (needs the AWS setup above).
# Router-tier calls are excluded: they already degrade gracefully and stay latency-capped.
# Note: the fallback path bypasses OpenAI guardrails on the retriever.
LLM_BEDROCK_FALLBACK=1

# Configure LLM details for specific tasks via JSON
#   - check app/core/llm_config.py for details and defaults
#   - override one or more of
#       - "provider"        => overrides LLM_PROVIDER for this task (OPENAI or BEDROCK)
#       - "model"           => global default OPENAI_MODEL or BEDROCK_MODEL, configured per task in llm_config.py
#       - "temperature"     => no global default, configured per task in llm_config.py
#       - "max_tokens"      => global default MAX_TOKENS value in this .env, configured per task in llm_config.py
#       - "reasoning_effort"=> optional; OpenAI reasoning models only; values are model-specific (e.g. minimal, low, medium, high for gpt-5-mini)
#
# e.g.:
#   LLM_HYDE={"temperature": 0.9}
#   LLM_CLASSIFIER={"model": "gpt-4o"}
#   LLM_DECOMPOSER={"model": "gpt-4o", "temperature": 0.2, "max_tokens": 1000}
#   LLM_SUMMARIZER={"provider": "BEDROCK", "model": "eu.amazon.nova-lite-v1:0"}
#   LLM_RETRIEVER={"model": "gpt-5-mini", "reasoning_effort": "low"}
#
# Available tasks (check llm_config.py):
# LLM_DECOMPOSER, LLM_SYNTHESIZER, LLM_CLASSIFIER, LLM_CLASSIFIER_DECOMPOSER, LLM_REWRITER,
# LLM_HYDE, LLM_REPHRASER, LLM_ANSWER_JUDGE, LLM_INGESTOR_CLASSIFY,
# LLM_INGESTOR_EXTRACT, LLM_TOPIC_EXTRACTOR, LLM_CONTEXT_EXTRACTOR, LLM_RETRIEVER, LLM_SUMMARIZER, LLM_ERROR_HANDLER,
# LLM_SUB_QUERY_EXECUTOR, LLM_RAG_ROUTER, LLM_SCENARIO_REPLY, LLM_LANGUAGE_DETECTOR,
# LLM_DIRECTIVE_JUDGE, LLM_RESOURCE_SELECTOR
#
# unified classifier+decomposer (used when ROUTER_UNIFIED_CLASSIFIER_DECOMPOSER=1):
#   LLM_CLASSIFIER_DECOMPOSER={"model": "gpt-5-mini", "temperature": 0.0, "max_tokens": 1200, "reasoning_effort": "low"}

# reasoning tasks - use gpt-5 reasoning models (see MODEL_EVALUATION.md for rationale)
LLM_SYNTHESIZER={"model": "gpt-5-nano", "reasoning_effort": "low"}
LLM_DECOMPOSER={"model": "gpt-5-mini", "temperature": 0.0, "max_tokens": 800, "reasoning_effort": "low"}
# classify/route seems to be easier now, let's use fast NON-reasoning model (reasoning models add latency here)
LLM_CLASSIFIER_DECOMPOSER={"model": "gpt-4.1-mini", "temperature": 0.0, "max_tokens": 600}
LLM_REWRITER={"model": "gpt-5-mini", "temperature": 0.0, "reasoning_effort": "low"}
LLM_SUMMARIZER={}
LLM_RETRIEVER={}
# language detection needs a model that separates closely related languages: gpt-4o-mini
# consistently misreads short Portuguese messages as Spanish, gpt-4.1-mini does not
LLM_LANGUAGE_DETECTOR={"model": "gpt-4.1-mini", "temperature": 0.0, "max_tokens": 50}
# the directive judge reviews replies for carried-out profile-text injections: gpt-4o-mini
# sometimes inverts the task (flags a reply for NOT obeying the injected directive), gpt-4.1-mini holds
LLM_DIRECTIVE_JUDGE={"model": "gpt-4.1-mini", "temperature": 0.0, "max_tokens": 1000}

# enable logging of LLM requests and responses for debugging
ENABLE_LLM_LOGGING=0

# # reasoning tasks BEDROCK config
# LLM_SYNTHESIZER={"model": "openai.gpt-oss-120b-1:0"}
# LLM_DECOMPOSER={"model": "openai.gpt-oss-120b-1:0", "temperature": 0.0, "max_tokens": 800}
# LLM_REWRITER={"model": "openai.gpt-oss-120b-1:0", "temperature": 0.0}
# LLM_SUMMARIZER={"model": "eu.amazon.nova-micro-v1:0"}

# Amazon Bedrock API key
AWS_BEARER_TOKEN_BEDROCK=

# Neo4j connection per hub ID
NEO4J_HUB_CONFIG={"1": {"uri": "bolt://neo4j:7687", "username": "neo4j", "password": "0Mt1zB77qI"}, "2": {"uri": "bolt://neo4j:7687", "username": "neo4j", "password": "0Mt1zB77qI"}, "3": {"uri": "bolt://neo4j:7687", "username": "neo4j", "password": "0Mt1zB77qI"}, "4": {"uri": "bolt://neo4j:7687", "username": "neo4j", "password": "0Mt1zB77qI"}, "5": {"uri": "bolt://neo4j:7687", "username": "neo4j", "password": "0Mt1zB77qI"}, "6": {"uri": "bolt://neo4j:7687", "username": "neo4j", "password": "0Mt1zB77qI"}}

# Default Neo4j instance used when a hub ID is not found in the custom config
NEO4J_HUB_DEFAULT_CONFIG={"uri": "bolt://neo4j:7687", "username": "neo4j", "password": "0Mt1zB77qI"}

# The password is the same for all HUB IDs in local environment. It is used during Neo4j first time setup on a container
NEO4J_PASSWORD=0Mt1zB77qI

# Add only to .env.integration as the tests should be able to connect to Neo4j without HUB ID configuration
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j

# End of Neo4j connection setup

# RQ Worker settings
REDIS_URL=redis://redis:6379/1
RQ_RETRY_MAX=5
RQ_HEALTH_CHECK_PORT=8001
RQ_WORKER_COUNT=4
RQ_JOB_TIMEOUT=1800
RQ_QUEUES=chat,ingestion,removal,callback

SENTRY_DSN=""

# supported languages for language detection (JSON array of ISO 639-1 codes)
# https://en.wikipedia.org/wiki/List_of_ISO_639_language_codes
# SUPPORTED_LANGUAGES=["ar", "en", "fr", "pt", "es", "hi"]

AWS_EC2_METADATA_DISABLED=true
