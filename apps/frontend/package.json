{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0 && stylelint 'src/**/*.css'",
    "lint:fix": "eslint . --fix && stylelint --fix 'src/**/*.css'",
    "preview": "vite preview",
    "test:unit": "vitest",
    "extract": "formatjs extract 'src/**/*.ts*' --ignore='**/*.d.ts' --out-file lang/en.json --throws --format simple",
    "watch:bundle-size": "node scripts/checkBundleSize.cjs",
    "check:unused-css": "node scripts/findUnusedCssModuleClasses.cjs",
    "check:unused-code": "knip"
  },
  "dependencies": {
    "@formatjs/intl-durationformat": "^0.10.18",
    "@mdxeditor/editor": "^4.2.3",
    "@sentry/react": "^10.18.0",
    "@sentry/vite-plugin": "^5.1.1",
    "@simpleanalytics/react": "^0.0.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@xyflow/react": "^12.8.4",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.12.41",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intl": "^10.1.13",
    "react-linkify-it": "^2.0.0",
    "react-qr-code": "^2.0.21",
    "react-router": "^8.3.0",
    "recharts": "^3.8.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@formatjs/cli": "^6.7.2",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.13",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.31.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.0.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.41.0",
    "rollup-plugin-visualizer": "^7.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-order": "^ 8.1.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^8.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.12"
  }
}
