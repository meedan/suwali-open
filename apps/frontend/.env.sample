DEPLOY_ENV=local
FRONTEND_PORT=5173
# VITE_ prefix is required for Vite to expose these variables to the client-side code
# Remember to update apps/frontend/bin/docker-entrypoint.sh for production as well
# In deployed environments, set VITE_API_BASE_URL on the container (required; no default).
VITE_API_BASE_URL=http://localhost:3000/api
# Get DSN from Sentry project settings
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=${DEPLOY_ENV}
VITE_SENTRY_RELEASE=${SENTRY_RELEASE}
# Enable SimpleAnalytics tracking (set to 'true' in production)
VITE_ENABLE_ANALYTICS=
# Set to 'false' to hide the React Query devtools button
# VITE_REACT_QUERY_DEVTOOLS=false
# Subscribers a topic needs before the dashboard will flag it as an underserved audience.
# Defaults to 10 when unset; 5 here because seeded hubs have only a handful of end-users.
VITE_MIN_TOPIC_SUBSCRIBERS=5
