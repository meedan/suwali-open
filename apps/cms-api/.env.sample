DEPLOY_ENV=local
CMS_API_PORT=3000
CMS_API_HOST=localhost
CMS_API_INTERNAL_URL=http://cms-api:3000
CMS_API_EXTERNAL_URL=http://localhost:3000
RAILS_MAX_THREADS=5

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_DB=suwali_cms_api
# You can also set the special variable DATABASE_URL:
# DATABASE_URL="postgres://myuser:mypass@host/somedatabase"

DEVISE_JWT_SECRET_KEY=thisvalueisonlyusedforlocaldevelopmentenvironment

# ActiveRecord Encryption keys for encrypting messaging integration credentials.
# Generate with: rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=thisvalueisonlyusedforlocaldevelopmentenvironment
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=thisvalueisonlyusedforlocaldevelopmentenvironment
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=thisvalueisonlyusedforlocaldevelopmentenvironment

EMAIL_FROM="Suwali <no-reply@suwali.io>"
SALES_EMAIL_FROM="Suwali <sales@suwali.io>"
SMTP_HOST=mailcatcher
SMTP_PORT=1025
# SMTP user and password only required in production
# SMTP_USERNAME
# SMTP_PASSWORD

REDIS_URL=redis://redis:6379/1
# You can define a different Redis database for Rack::Attack, when not present, defaults to REDIS_URL
# REDIS_RACK_ATTACK_URL=redis://redis:6379/2
FRONTEND_URL=http://localhost:5173
S3_ACCESS_KEY_ID=silo
S3_SECRET_ACCESS_KEY=silo-secret
S3_REGION=eu-west-1
S3_BUCKET=documents-dev
S3_ENDPOINT=http://silo:9000
# host browsers use for presigned download links; leave empty in production
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# See README for instructions
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_SHARE_EMAIL=ckh-local@ckh-local.iam.gserviceaccount.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

KNOWLEDGE_SERVICE_URL=http://knowledge:8000
KNOWLEDGE_SERVICE_CALLBACK_TOKEN=thisvalueisonlyusedforlocaldevelopmentenvironment

SECRET_KEY_BASE=thisvalueisonlyusedforlocaldevelopmentenvironment

WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_CONFIGURATION_ID=
WHATSAPP_CREDIT_LINE_ID=
WHATSAPP_SYSTEM_TOKEN=
WHATSAPP_SYSTEM_USER_ID=

# Twilio integration
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# signal-cli daemon (services/signal-cli); never expose it publicly, it has no authentication
SIGNAL_CLI_URL=http://signal-cli:8080

SENTRY_DSN=

# Limits
MAX_NOTEBOOK_ITEMS=200

MESSAGE_RATE_LIMIT=3
MESSAGE_RATE_LIMIT_TIMEOUT_MINUTES=30

# Hub trial length in days
HUB_TRIAL_LENGTH_DAYS=30

SUPPORT_EMAIL=support@suwali.io
SCHEDULE_DEMO_LINK=https://suwali.io/demo

# Key for the AI provider to be used with RubyLLM
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4

# Public URL of a PDF added to every new hub as its first data source. Leave empty to disable.
PRELOADED_PDF_DOCUMENT_URL="https://docs.google.com/document/d/1kvWdZnYywF1CJUvOetmhAE0wUSyrX0ijHe6j9kzdcNs/export?format=pdf"
